DEFINE FIELD IF NOT EXISTS observation_id ON TABLE mpls TYPE string;
DEFINE FIELD IF NOT EXISTS observed_at ON TABLE mpls TYPE string;
DEFINE FIELD IF NOT EXISTS vrf ON TABLE mpls TYPE string ASSERT (string::trim($value) != '');
DEFINE FIELD IF NOT EXISTS name ON TABLE mpls TYPE string ASSERT (string::trim($value) != '');
DEFINE FIELD IF NOT EXISTS enabled ON TABLE mpls TYPE option<bool>;
DEFINE FIELD IF NOT EXISTS signaling_protocol ON TABLE mpls TYPE option<string>;
DEFINE FIELD IF NOT EXISTS ingress ON TABLE mpls TYPE option<object> FLEXIBLE;
DEFINE FIELD IF NOT EXISTS transit ON TABLE mpls TYPE option<object> FLEXIBLE;
DEFINE FIELD IF NOT EXISTS egress ON TABLE mpls TYPE option<object> FLEXIBLE;
DEFINE FIELD IF NOT EXISTS label_stack ON TABLE mpls TYPE option<array<int>>;
DEFINE FIELD IF NOT EXISTS next_hops ON TABLE mpls TYPE option<array<object>> FLEXIBLE;
DEFINE INDEX IF NOT EXISTS resource_identity ON TABLE mpls FIELDS device_name, vrf, name UNIQUE;
DEFINE INDEX IF NOT EXISTS resource_device_time ON TABLE mpls FIELDS device_name, observed_at;

